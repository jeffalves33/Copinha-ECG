<!-- views/tickets/login.ejs -->
<!DOCTYPE html>
<html lang="pt-br">

<%- include('../partials/head', { title: 'IngressosNaJu - Login' }) %>

    <body class="d-flex justify-content-center align-items-center vh-100 bg-dark">
        <div class="card p-4 shadow-lg" style="max-width: 400px; width: 90%;">
            <div class="card-body">
                <h3 class="card-title text-center mb-4">Login</h3>
                <form onsubmit="authenticate(event)">
                    <div class="mb-3">
                        <label for="userCPF" class="form-label">CPF</label>
                        <input type="text" id="userCPF" class="form-control form-control-lg"
                            placeholder="Digite seu CPF" oninput="inputformatCPF(this)" required>
                    </div>
                    <div class="mb-4">
                        <label for="userPhone" class="form-label">Telefone</label>
                        <input type="text" id="userPhone" class="form-control form-control-lg"
                            placeholder="Digite seu telefone" oninput="inputformatPhoneNumber(this)" required>
                    </div>
                    <button type="submit" class="btn btn-primary btn-lg w-100">Entrar</button>
                </form>
            </div>
        </div>

        <script>
            document.addEventListener("DOMContentLoaded", function () {
                const userCPF = localStorage.getItem('userCPF');
                if (userCPF) document.getElementById("userCPF").value = userCPF;
            });

            function authenticate(event) {
                event.preventDefault();

                const userCPF = document.getElementById("userCPF").value;
                const userPhone = document.getElementById("userPhone").value;
                const userCPFLocalStorage = localStorage.getItem("userCPF");

                if (userCPF === userCPFLocalStorage || userCPFLocalStorage === null) {
                    fetch(`/login`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({ cpf: userCPF, phone: userPhone })
                    })
                        .then(response => {
                            if (!response.ok) {
                                return response.json().then(err => { throw new Error(err.message || 'Erro de autenticação.'); });
                            }
                            return response.json();
                        })
                        .then(data => {
                            if (data.user != null) {
                                localStorage.setItem("userEmail", data.user.email);
                                localStorage.setItem("userName", data.user.nome);
                                localStorage.setItem("userPhone", data.user.phone);
                                localStorage.setItem("userId", data.user.id);
                                localStorage.setItem("userCPF", userCPF);

                                const ingresso = localStorage.getItem("ingresso");
                                if (ingresso === "baixar") {
                                    window.location.href = "/download-tickets-page";
                                } else {
                                    window.location.href = "/select-tickets";
                                }
                            } else {
                                alert("CPF ou telefone inválidos!");
                            }
                        })
                        .catch(error => {
                            console.error('Erro de autenticação:', error);
                            alert(error.message || 'Ocorreu um erro ao tentar fazer login.');
                        });
                } else {
                    alert("CPF inserido não corresponde ao CPF salvo localmente!");
                    document.getElementById("userCPF").value = "";
                }
            }

            function inputformatPhoneNumber(input) {
                let value = input.value.replace(/\D/g, '');
                if (value.length > 0) value = '(' + value;
                if (value.length > 3) value = value.slice(0, 3) + ') ' + value.slice(3);
                if (value.length > 10) value = value.slice(0, 10) + '-' + value.slice(10, 15);
                input.value = value;
            }

            function inputformatCPF(input) {
                let value = input.value.replace(/\D/g, '');
                if (value.length > 3) value = value.slice(0, 3) + '.' + value.slice(3);
                if (value.length > 7) value = value.slice(0, 7) + '.' + value.slice(7);
                if (value.length > 11) value = value.slice(0, 11) + '-' + value.slice(11, 13);
                input.value = value;
            }
        </script>
    </body>

</html>